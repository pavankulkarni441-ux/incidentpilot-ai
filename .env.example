# ANTHROPIC_API_KEY: Required for Claude AI incident diagnosis API calls.
# Users configure this via the Secrets panel in AI Studio or deployment environment.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# GEMINI_API_KEY: Required for Gemini AI API calls (preserved for dual-engine support).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# N8N_WEBHOOK_URL: Required for n8n production webhook automated remediation workflow (preserved).
# Never expose this or any secrets in client-side code.
# Users configure this via the Secrets panel in the AI Studio UI (or .env for local testing).
# Example: "https://your-n8n-instance.app.n8n.cloud/webhook/incident-approval"
N8N_WEBHOOK_URL="https://your-n8n-instance.app.n8n.cloud/webhook/incident-approval"

# SLACK_BOT_TOKEN: Bot User OAuth Token (xoxb-...) for posting incident alerts and updating messages via Slack Web API.
# Server-side only. Never expose to frontend or logs.
SLACK_BOT_TOKEN="MY_SLACK_BOT_TOKEN"

# SLACK_SIGNING_SECRET: Signing secret used to verify HMAC-SHA256 signatures on incoming Slack interactive requests.
# Server-side only. Never expose to frontend or logs.
SLACK_SIGNING_SECRET="MY_SLACK_SIGNING_SECRET"

# SLACK_CHANNEL_ID: Target Slack Channel ID (e.g. C0123456789) where incident notifications and approval cards are posted.
SLACK_CHANNEL_ID="MY_SLACK_CHANNEL_ID"

# AUTHORIZED_COMMANDERS: Comma-separated list of Slack user IDs or usernames authorized to approve/reject remediation actions.
AUTHORIZED_COMMANDERS="U01234567,sarah.chen"

# WORKFLOW_STORE: Persistence backend for workflows, approvals, and audit events ("memory" or "firestore").
# Local dev and automated tests default to "memory". Cloud Run deployments should set "firestore"
# and authenticate automatically via Cloud Run service-account IAM (no embedded keys).
WORKFLOW_STORE="memory"

# GOOGLE_CLOUD_PROJECT / FIRESTORE_DATABASE_ID: Optional overrides for FirestoreStore when running outside default project/database.
# GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
# FIRESTORE_DATABASE_ID="(default)"

# METRICS_PROVIDER: Telemetry provider mode ("mock" default for simulated local dev/tests, or "prometheus" for live Prometheus HTTP API).
METRICS_PROVIDER="mock"
# PROMETHEUS_URL="http://localhost:9090"

# LOG_PROVIDER: Structured log provider mode ("mock" default for simulated local dev/tests, or "http" for external log source).
LOG_PROVIDER="mock"
# LOG_SOURCE_URL="http://localhost:9100"

# TRACE_PROVIDER: Distributed trace provider mode ("mock" default for simulated local dev/tests, or "http" for external HTTP trace source).
TRACE_PROVIDER="mock"
# TRACE_SOURCE_URL="http://localhost:9200"
